<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Captura ampliada">
    <button type="button" class="close" id="close-lightbox" aria-label="Cerrar imagen">×</button>
    <img id="lightbox-image" src="assets/forest.webp" alt="Captura del prototipo ampliada">
    <p id="lightbox-caption"></p>
    <div class="lightbox-actions"><button id="previous-image" type="button" aria-label="Imagen anterior">← <span data-lang="es">Anterior</span><span data-lang="en">Previous</span></button><button id="next-image" type="button" aria-label="Imagen siguiente"><span data-lang="es">Siguiente</span><span data-lang="en">Next</span> →</button></div>
  </div>

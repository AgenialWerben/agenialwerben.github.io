---
import Brand from './Brand.astro';
---
<header class="header">
    <div class="shell nav">
      <a href="#top" class="wordmark notranslate" lang="en" translate="no" aria-label="TFOC — inicio"><Brand variant="short" /></a>
      <nav id="navlinks" class="navlinks" aria-label="Navegación principal">
        <a href="#experience"><span data-lang="es">La experiencia</span><span data-lang="en">The experience</span></a>
        <a href="#world"><span data-lang="es">Cómo funciona</span><span data-lang="en">How it works</span></a>
        <a href="#gallery"><span data-lang="es">Galería</span><span data-lang="en">Gallery</span></a>
        <a href="#progress-section"><span data-lang="es">Desarrollo</span><span data-lang="en">Development</span></a>
        <a href="#studio"><span data-lang="es">Estudio</span><span data-lang="en">Studio</span></a>
        <a href="#contact"><span data-lang="es">Contacto</span><span data-lang="en">Contact</span></a>
      </nav>
      <button class="lang" id="language" type="button" aria-label="Change site language to English">EN</button>
      <button class="menu-toggle" id="menu" type="button" aria-expanded="false" aria-controls="navlinks" aria-label="Abrir menú">☰</button>
    </div>
  </header>

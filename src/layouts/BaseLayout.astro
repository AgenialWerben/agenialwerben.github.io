---
import '../styles/site.css';
import '../styles/project-explainer.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Lightbox from '../components/Lightbox.astro';
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#050505">
  <meta name="color-scheme" content="dark">
  <meta name="description" content="The Fiven Or Community. Estudio independiente de videojuegos que investiga mundos procedurales, exploración, simulación y RPG sandbox. Conoce nuestro proyecto en desarrollo.">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="The Fiven Or Community">
  <meta property="og:title" content="TFOC — The Fiven Or Community">
  <meta property="og:description" content="No seguimos mapas. Los creamos. Videojuegos independientes, mundos procedurales y nuevas formas de explorar.">
  <meta property="og:url" content="https://thefivenorcommunity.tech/">
  <meta property="og:image" content="https://thefivenorcommunity.tech/assets/forest.webp">
  <title lang="en" translate="no" class="notranslate">TFOC — The Fiven Or Community / Independent Game Studio</title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 96 96'%3E%3Crect width='96' height='96' fill='%23050505'/%3E%3Ctext x='48' y='59' font-family='Arial,sans-serif' font-size='25' font-weight='900' text-anchor='middle' fill='white'%3ETFOC%3C/text%3E%3C/svg%3E">
  <link rel="preload" href="assets/forest.webp" as="image" type="image/webp">
  
</head>
<body translate="yes">
<div class="progress" id="progress" aria-hidden="true"></div>
<Header />
<slot />
<Footer />
<Lightbox />
<script>import '../scripts/site.ts';</script>
</body>
</html>

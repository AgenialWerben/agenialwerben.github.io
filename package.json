{
  "name": "tfoc-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build && node scripts/copy-assets.mjs",
    "check": "tsc --noEmit",
    "preview": "astro preview --host 0.0.0.0",
    "audit:site": "node scripts/security-check.mjs",
    "audit:deps": "npm audit --audit-level=high"
  },
  "dependencies": {
    "astro": "^5.16.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
